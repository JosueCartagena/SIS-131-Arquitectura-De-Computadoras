
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>
#include <unistd.h>
#include <sys/socket.h>
#include <sys/un.h>
#include <time.h>

#define PKT 64
#define SOCK_PATH "/tmp/ipc_no.sock"

typedef struct { uint64_t seq; uint8_t data[56]; } packet_t;
_Static_assert(sizeof(packet_t) == PKT, "paquete debe ser 64 bytes");

static double now(void) {
    struct timespec t;
    clock_gettime(CLOCK_MONOTONIC, &t);
    return t.tv_sec + t.tv_nsec / 1e9;
}

/* Lee exactamente PKT bytes; devuelve 0 si hay EOF */
static int read_full(int fd, packet_t *p) {
    size_t got = 0;
    while (got < PKT) {
        ssize_t r = recv(fd, (char *)p + got, PKT - got, 0);
        if (r <= 0) return 0;
        got += r;
    }
    return 1;
}

int main(void) {
    unlink(SOCK_PATH);
    int ls = socket(AF_UNIX, SOCK_STREAM, 0);
    if (ls < 0) { perror("socket"); return 1; }

    struct sockaddr_un addr;
    memset(&addr, 0, sizeof addr);
    addr.sun_family = AF_UNIX;
    strncpy(addr.sun_path, SOCK_PATH, sizeof(addr.sun_path) - 1);

    if (bind(ls, (struct sockaddr *)&addr, sizeof addr) < 0) { perror("bind"); return 1; }
    if (listen(ls, 1) < 0) { perror("listen"); return 1; }

    int fd = accept(ls, NULL, NULL);      /* espera al productor */
    if (fd < 0) { perror("accept"); return 1; }

    packet_t p;
    uint64_t count = 0, sum = 0;
    double t0 = now();
    while (read_full(fd, &p)) {           /* 1 syscall por paquete */
        sum += p.seq;
        count++;
    }
    double t = now() - t0;

    close(fd);
    close(ls);
    unlink(SOCK_PATH);

    printf("[CONS_NO] paquetes=%llu checksum=%llu tiempo=%.3f s  %.0f paq/s  %.1f MB/s\n",
           (unsigned long long)count, (unsigned long long)sum,
           t, count / t, count * PKT / t / 1e6);
    return 0;
}



